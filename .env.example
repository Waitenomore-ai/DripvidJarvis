# JARVIS must remain localhost-only in standalone mode.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=3342

JARVIS_REQUEST_TIMEOUT_MS=3000
JARVIS_CONFIRMATION_TTL_MS=120000
JARVIS_CHAT_TIMEOUT_MS=120000
JARVIS_MAX_AGENT_ITERATIONS=5

JARVIS_DRIPVID_BASE_URL=http://127.0.0.1:3000
JARVIS_DRIPVID_HEALTH_URL=http://127.0.0.1:3000/api/health

JARVIS_MCP_ENDPOINT=http://127.0.0.1:8788/mcp
JARVIS_MCP_BEARER=

# JARVIS brain: direct OpenAI access (no Tech-AI dependency).
JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=gpt-5.6-luna

# Optional fallback agent (OpenAI-compatible). Used when the primary
# provider is rate-limited or failing. OmniRoute slots in here when ready.
JARVIS_FALLBACK_BASE_URL=
JARVIS_FALLBACK_API_KEY=
JARVIS_FALLBACK_MODEL=gpt-5.6-luna
JARVIS_MODEL_FALLBACK_COOLDOWN_MS=600000

# Server-side memory store.
JARVIS_BRAIN_PATH=
JARVIS_BRAIN_MAX_MEMORIES=200
JARVIS_BRAIN_RECALL_LIMIT=5