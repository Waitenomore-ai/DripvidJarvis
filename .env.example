# JARVIS must remain localhost-only in standalone mode.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=3342

JARVIS_REQUEST_TIMEOUT_MS=3000
JARVIS_CONFIRMATION_TTL_MS=120000
JARVIS_CHAT_TIMEOUT_MS=120000
JARVIS_MAX_AGENT_ITERATIONS=5
# Natural-language read-only diagnostics are bounded independently.
JARVIS_MAX_DIAGNOSTIC_ROUNDS=4
JARVIS_MAX_DIAGNOSTIC_CALLS=8
# Retries for a single chat round trip; each retry waits out the
# provider's reported rate-limit window (capped) when possible.
JARVIS_CHAT_RETRIES=2
JARVIS_RATE_LIMIT_BACKOFF_MS=60000
# Large tool outputs are truncated before being fed back to the model.
JARVIS_MAX_TOOL_RESULT_CHARS=4000

JARVIS_DRIPVID_BASE_URL=http://127.0.0.1:3000
JARVIS_DRIPVID_HEALTH_URL=http://127.0.0.1:3000/api/health

JARVIS_MCP_ENDPOINT=http://127.0.0.1:8788/mcp
JARVIS_MCP_BEARER=

# JARVIS brain: direct OpenAI access (no Tech-AI dependency).
# Any OpenAI-compatible endpoint works here, including a local model server.
# Example for LM Studio listening on 127.0.0.1:1234:
#   JARVIS_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
#   JARVIS_OPENAI_API_KEY=lm-studio
#   JARVIS_OPENAI_MODEL=qwen2.5-coder-7b-instruct
JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=gpt-5.6-luna

# Optional fallback agent (OpenAI-compatible). Used when the primary
# provider is rate-limited or failing. OmniRoute slots in here when ready.
JARVIS_FALLBACK_BASE_URL=
JARVIS_FALLBACK_API_KEY=
JARVIS_FALLBACK_MODEL=gpt-5.6-luna
JARVIS_MODEL_FALLBACK_COOLDOWN_MS=600000

# JARVIS voice: ElevenLabs server-side TTS for spoken replies.
# Default: Daniel - Steady Broadcaster (free british male).
# NOTE: wDsJlOXPqcvIUKdLXjDs (operator's chosen voice) needs Creator tier.
JARVIS_ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
JARVIS_ELEVENLABS_API_KEY=
JARVIS_ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
JARVIS_ELEVENLABS_MODEL=eleven_turbo_v2_5

# Server-side memory store.
JARVIS_BRAIN_PATH=
JARVIS_BRAIN_MAX_MEMORIES=200
JARVIS_BRAIN_RECALL_LIMIT=5

# Obsidian vault for operator memory. Defaults to vault/ (auto-created on
# first run with a welcome note). An explicitly configured path is used
# as-is and is never auto-created: it must already exist (or be mounted).
JARVIS_VAULT_PATH=
JARVIS_VAULT_INDEX_PATH=
JARVIS_VAULT_SEARCH_LIMIT=5
JARVIS_VAULT_READ_MAX_CHARS=16000
