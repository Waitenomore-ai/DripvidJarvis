[Unit]
Description=DripVid JARVIS Host MCP
After=network.target

[Service]
Type=simple
User=dripvid-jarvis
Group=dripvid-jarvis
WorkingDirectory=/opt/dripvid-jarvis
EnvironmentFile=/etc/dripvid-jarvis.env
ExecStart=/usr/bin/node /opt/dripvid-jarvis/src/mcp-server/server.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

ReadOnlyPaths=/opt/dripvid-jarvis
ReadWritePaths=/opt/dripvid-jarvis/data

[Install]
WantedBy=multi-user.target
