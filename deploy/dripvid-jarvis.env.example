# DripVid JARVIS — production environment template
# Copy to /etc/dripvid-jarvis.env (chmod 600, root-owned), edit secrets,
# then: sudo systemctl restart dripvid-jarvis
#
# Runbook: deploy/README.md  •  systemd: deploy/dripvid-jarvis.service

# ---- Binding (keep loopback; nginx reaches it via proxy_pass) ----
JARVIS_HOST=127.0.0.1
JARVIS_PORT=3342

# ---- Primary LLM provider (OpenAI-compatible). Use a CLOUD key in prod. ----
JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_OPENAI_API_KEY=CHANGE_ME
JARVIS_OPENAI_MODEL=gpt-5.6-luna

# ---- Optional fallback provider (OpenAI-compatible) ----
# Uncomment to enable automatic failover when the primary is rate-limited.
# JARVIS_FALLBACK_BASE_URL=https://api.together.xyz/v1
# JARVIS_FALLBACK_API_KEY=CHANGE_ME
# JARVIS_FALLBACK_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ---- DripVid and MCP (same host or reachable on the LAN) ----
JARVIS_DRIPVID_BASE_URL=http://127.0.0.1:3000
# JARVIS_DRIPVID_HEALTH_URL=http://127.0.0.1:3000/api/health
# JARVIS_MCP_ENDPOINT=http://127.0.0.1:8788/mcp
# JARVIS_MCP_BEARER=

# ---- Voice (optional: ElevenLabs). Leave empty to use browser voice. ----
# JARVIS_ELEVENLABS_API_KEY=
# JARVIS_ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# JARVIS_ELEVENLABS_MODEL=eleven_turbo_v2_5

# ---- Vault (must live under /opt/dripvid-jarvis, per ReadWritePaths) ----
JARVIS_VAULT_PATH=/opt/dripvid-jarvis/vault
# JARVIS_VAULT_INDEX_PATH=/opt/dripvid-jarvis/data/vault-index.json

# ---- Brain / misc state ----
# JARVIS_BRAIN_PATH=/opt/dripvid-jarvis/data/brain.json
# JARVIS_VERIFY_RESULT_PATH=/opt/dripvid-jarvis/data/auto-verify.result

# ---- Tuning (rarely needed) ----
# JARVIS_REQUEST_TIMEOUT_MS=3000
# JARVIS_MAX_DIAGNOSTIC_ROUNDS=4
# JARVIS_MAX_DIAGNOSTIC_CALLS=8
# JARVIS_CONFIRMATION_TTL_MS=120000